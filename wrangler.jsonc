{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "md-atlas",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "md-atlas.reiinoki.dpdns.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./.wrangler/assets",
    "not_found_handling": "single-page-application"
  }
}
