{
  "name": "md-atlas",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive Ingress Mission Day archive built with React, Vite and MapLibre GL.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReiiNoki/md-atlas.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prepare-workers-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cloudflare": "wrangler dev --local --ip 127.0.0.1",
    "deploy:check": "wrangler deploy --dry-run --no-autoconfig",
    "test": "node --test \"tests-js/*.test.js\"",
    "test:browser": "npm run build && node scripts/check-map-browser.mjs",
    "test:browser:dev": "node scripts/check-map-browser.mjs --dev",
    "test:browser:workers": "npm run build && node scripts/check-map-browser.mjs --workers",
    "test:workers": "node scripts/check-workers.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/rajdhani": "^5.2.6",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "vite": "^6.0.7",
    "wrangler": "4.131.1"
  }
}
